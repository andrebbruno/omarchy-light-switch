# Maintainer: Andre Bruno
pkgname=omarchy-light-switch
pkgver=0.1.0
pkgrel=1
pkgdesc="Light Switch for Omarchy — a light theme by day and a dark one at night, by the clock or by the sun (PowerToys Light Switch, ported)"
arch=('any')
url="https://github.com/andrebbruno/omarchy-light-switch"
license=('MIT')
depends=('python')
optdepends=('gum: menu fallback outside Omarchy'
            'libnotify: notifications when the theme changes')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
checkdepends=('python-pytest')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  PYTHONPATH="$PWD" python -m pytest tests -q
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 systemd/omarchy-light-switch.service \
    "$pkgdir/usr/lib/systemd/user/omarchy-light-switch.service"
  install -Dm644 systemd/omarchy-light-switch.timer \
    "$pkgdir/usr/lib/systemd/user/omarchy-light-switch.timer"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
